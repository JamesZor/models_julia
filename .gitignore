# Per-machine Julia env. Project.toml stays tracked (the package needs its
# dependency list); Manifest.toml is resolved locally on each machine.
Manifest.toml
.cache/
.env

# Run artifacts — regenerated by runners, never committed.
# Serialized chains, fitted models, backtest results (49M+ on some machines).
*.jls
*.orig

# Root-level scratch output dropped by REPL sessions.
/plots/
/mcmc_checkpoints/
/*.png
/*.html
/odds_df
/odds_df.csv

# Per-stream runner output directories.
current_development/*/out/
